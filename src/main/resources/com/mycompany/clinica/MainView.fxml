<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clinica.MainViewController">

    <!-- Panel izquierdo con botones -->
    <left>
        <VBox prefHeight="613.0" prefWidth="130.0" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
         <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@logo.png" />
            </image>
         </ImageView>
            <Button maxWidth="Infinity" onAction="#showFacturas" style="-fx-text-fill: white; -fx-background-color: #34495e;" text="Facturas" textAlignment="CENTER">
            <VBox.margin>
               <Insets bottom="20.0" top="50.0" />
            </VBox.margin></Button>
            <Button maxWidth="Infinity" onAction="#showPacientes" style="-fx-text-fill: white; -fx-background-color: #34495e;" text="Pacientes" textAlignment="CENTER">
            <VBox.margin>
               <Insets bottom="20.0" />
            </VBox.margin></Button>
            <Button maxWidth="Infinity" onAction="#showCitas" style="-fx-text-fill: white; -fx-background-color: #34495e;" text="Citas" textAlignment="CENTER" />
        </VBox>
    </left>

    <!-- Panel derecho donde se cargan las vistas -->
    <center>
        <AnchorPane fx:id="contentPane" prefHeight="613.0" prefWidth="671.0" />
    </center>

</BorderPane>
