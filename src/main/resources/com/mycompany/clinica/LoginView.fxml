<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.clinica.LoginController"
      spacing="10" alignment="CENTER">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Logo arriba -->
    <ImageView fx:id="logoImage" fitWidth="240" fitHeight="240" preserveRatio="true">
        <image>
            <Image url="@logo.png" />
        </image>
    </ImageView>

    <Label text="Iniciar Sesión" style="-fx-font-size: 18px;"/>
    <TextField fx:id="txtUsername" promptText="Usuario"/>
    <PasswordField fx:id="txtPassword" promptText="Contraseña"/>
    <Button text="Entrar" fx:id="btnLogin" onAction="#handleLogin"/>
    <Label fx:id="lblMessage" textFill="red"/>
</VBox>
